# AI Syndicate ADMIN console — environment variables.
# Copy to .env.local for local dev. Set the same values in the Vercel
# project (Settings → Environment Variables) for production.
# Anything prefixed VITE_ is bundled into the browser. Secrets get no prefix.
# SETUP.md walks through where every value comes from, click by click.

# ============ 1. Supabase — SHARED with the platform ============
# Same project as the customer platform. Copy all three values from the
# platform's Vercel project env (or Supabase → Project Settings → API).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Service role key — server-only. Never VITE_-prefixed.
SUPABASE_SERVICE_ROLE_KEY=

# ============ 2. Base URL (used in invite emails) ============
# The deployed admin URL. Locally: http://localhost:5173
ADMIN_BASE_URL=

# ============ 2b. Our own platform (the "Open the platform" button) ============
# The console mints a one-time Supabase sign-in link for this account and opens
# the platform already signed in. Needs SUPABASE_SERVICE_ROLE_KEY above.
# PLATFORM_URL must be the bare origin — no /#/route (it breaks token parsing).
PLATFORM_URL=https://aisyndicate.com
# The platform account to sign in as. Leave blank and each teammate signs into
# their own platform login instead.
PLATFORM_ACCOUNT_EMAIL=

# ============ 3. Stripe (revenue + customers) — READ-ONLY key ============
# Make a RESTRICTED key: Stripe → Developers → API keys → Create restricted key
# with Read permission on Charges, Customers, Subscriptions, Prices. Read-only
# is enough — the console never writes to Stripe.
STRIPE_SECRET_KEY=

# ============ 4. Anthropic (AI drafting) ============
# The platform already has this key in its Vercel env — reuse it.
ANTHROPIC_API_KEY=

# ============ 5. Google OAuth (Gmail inbox) ============
# One OAuth app for the whole team; each member connects their own mailbox.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional override; defaults to https://<host>/api/gmail-callback
GMAIL_REDIRECT_URI=

# ============ 6. Token usage feed ============
# Invent a long random secret (40+ chars). The platform backend sends the
# same value in its x-ingest-key header when posting usage events.
USAGE_INGEST_KEY=

# ============ 7. Resend (optional) ============
# Same account the client lead forms use. Copy from the platform's Vercel env.
RESEND_API_KEY=

# ============ 8. The client's own accounts (Aug 24 2026) ============
# Search Console, Business Profile and Analytics all connect through the SAME
# Google OAuth app as the Gmail inbox above (section 5). There is no new key to
# create — but SIX APIs have to be switched on in that Google Cloud project,
# three new permissions have to be added to the consent screen, and one more
# redirect address has to be registered. SETUP.md § "Migration 0013 — the
# client's own accounts" lists all three, click by click.
#
# LOCAL DEV ONLY: set CONNECT_REDIRECT_URI below to the http:// address, or
# Google refuses the sign-in with redirect_uri_mismatch. Leave it unset in
# Vercel — the deployed site works its own address out.
#
# Optional override; defaults to https://<host>/api/connect-callback
CONNECT_REDIRECT_URI=

# ============ 9. The vault key ============
# 32 random bytes, base64:  openssl rand -base64 32
# It scrambles every stored password AND every client sign-in. Put the same
# value in Bitwarden the minute you make it: lose it and everything stored is
# unreadable for ever. Changing it does not re-scramble anything.
VAULT_KEY=

# ============ 10. The rest (each one only turns on its own feature) ============
# Where the platform's scan endpoint lives, for the score chip on a firm in Sales.
PLATFORM_SCORE_URL=
# Lead scraping — either one is enough on its own.
PLATFORM_LEADGEN_URL=
APOLLO_API_KEY=
# Without this the nightly lead run is closed, not open.
CRON_SECRET=
